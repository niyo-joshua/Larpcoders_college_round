APP_ENV=dev
DATABASE_URL=sqlite:///./incognito.db

# Ed25519 private key (base64, 32 bytes). Generate with: python seed_demo.py --gen-key
SIGNING_KEY_B64=

# Credential lifetime in seconds
CREDENTIAL_TTL_SECONDS=900

# Coarse timestamp bucket size in seconds (3600 = hour)
TIMESTAMP_BUCKET_SECONDS=3600

# Rate limiting
RATE_LIMIT_REDEEM=10/minute
RATE_LIMIT_SUBMIT=20/minute
RATE_LIMIT_ADMIN_LOGIN=5/minute
